{
  "name": "good-measure-giving",
  "main": "src/worker.ts",
  "compatibility_date": "2026-02-09",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Page requests must reach the Worker to retire legacy display URLs.
    "run_worker_first": ["/*", "!/assets/*", "!/data/*"],
    "not_found_handling": "none"
  }
}
